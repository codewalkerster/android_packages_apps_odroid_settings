<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/av_sync_background">
    <VideoView
            android:id="@+id/video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    <TextView
            android:id="@+id/text_shift"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="280dp"
            android:text="@string/av_sync_progress_textview"
            android:textSize="22sp" />
    <ImageView
            android:id="@+id/seek"
            android:layout_width="590dp"
            android:layout_height="48dp"
            android:layout_alignTop="@id/text_shift"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="40dp"
            android:src="@mipmap/seek" />
    <ImageView
            android:id="@+id/point"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_alignTop="@id/seek"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="14dp"
            android:src="@mipmap/point" />
    <TextView
            android:id="@+id/text_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/seek"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="64dp"
            android:gravity="center"
            android:textColor="@color/av_sync_text_hint_color"
            android:text="@string/av_sync_tuning_operation_description"
            android:textSize="18sp" />
    <android.widget.Button
            android:id="@+id/button_apply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/text_hint"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="76dp"
            android:background="@drawable/button_default"
            android:padding="10dp"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:text="@string/av_sync_apply"
            android:textColor="@color/av_sync_text_lack_color"
            android:textAllCaps="false"
            android:textSize="18sp" />
</RelativeLayout>

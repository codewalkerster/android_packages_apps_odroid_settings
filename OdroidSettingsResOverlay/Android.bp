package {
    default_applicable_licenses: ["packages_apps_Odroid_settings_overlay_license"],
}

license {
    name: "packages_apps_Odroid_settings_overlay_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
        "SPDX-license-identifier-BSD",
    ],
}

runtime_resource_overlay {
    name: "OdroidSettingsResOverlay",
    certificate: "platform",
    resource_dirs: ["res"],
    product_specific: true,
    sdk_version: "current",
    required: [
        "TvSettingsTwoPanel", // Use "TwoPanelSettingsOverlay" in pre-renaming code
    ],
}
